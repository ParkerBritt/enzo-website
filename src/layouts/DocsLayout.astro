---
import "../styles/global.css";
import DocsHeader from "../components/DocsHeader.astro";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";

interface Props {
	title: string;
	toc?: { id: string; label: string }[];
}

const { title, toc = [] } = Astro.props;

const guidePages = (await getCollection("guide")).sort((a, b) => a.data.order - b.data.order);

const guideNav: { label: string; items: { href: string; title: string }[] }[] = [];
for (const page of guidePages) {
	const item = { href: `/docs/guide/${page.id}`, title: page.data.title };
	const lastGroup = guideNav.at(-1);
	if (lastGroup?.label === page.data.section) {
		lastGroup.items.push(item);
	} else {
		guideNav.push({ label: page.data.section, items: [item] });
	}
}

const guideItems = guideNav.flatMap((group) => group.items.map((item) => ({ ...item, group: group.label })));

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const activeIndex = guideItems.findIndex((item) => item.href === pathname);
const activeItem = activeIndex >= 0 ? guideItems[activeIndex] : undefined;
const prevItem = activeIndex > 0 ? guideItems[activeIndex - 1] : undefined;
const nextItem = activeIndex >= 0 && activeIndex < guideItems.length - 1 ? guideItems[activeIndex + 1] : undefined;

const activeTab = pathname.startsWith("/docs/nodes") ? "Nodes" : pathname.startsWith("/docs/daslang") ? "DasLang" : "Guide";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="darkreader-lock" />
		<title>{title} · Enzo Docs</title>
		<ClientRouter />
	</head>
	<body transition:animate="none">
		<DocsHeader activeTab={activeTab} />

		<div class="docs-body">
			{
				activeTab === "Guide" && (
					<aside class="docs-sidebar" transition:persist="docs-sidebar">
						<nav>
							{guideNav.map((group) => (
								<details open>
									<summary>{group.label}</summary>
									<ul>
										{group.items.map((item) => (
											<li>
												<a href={item.href} class:list={{ active: item.href === pathname }}>
													{item.title}
												</a>
											</li>
										))}
									</ul>
								</details>
							))}
						</nav>
					</aside>
				)
			}

			<main class="docs-content">
				{
					activeItem && (
						<div class="breadcrumb">
							Guide
							{activeItem.group !== activeItem.title && (
								<>
									<span class="sep">/</span> {activeItem.group}
								</>
							)}
							<span class="sep">/</span> <span class="current">{activeItem.title}</span>
						</div>
					)
				}
				<article class="docs-article">
					<slot />
				</article>
				{
					(prevItem || nextItem) && (
						<div class="pager">
							{prevItem ? (
								<a class="pager-link prev" href={prevItem.href}>
									<span class="pager-label">← Prev</span>
									<span class="pager-title">{prevItem.title}</span>
								</a>
							) : (
								<span />
							)}
							{nextItem ? (
								<a class="pager-link next" href={nextItem.href}>
									<span class="pager-label">Next →</span>
									<span class="pager-title">{nextItem.title}</span>
								</a>
							) : (
								<span />
							)}
						</div>
					)
				}
			</main>

			{
				toc.length > 0 && (
					<aside class="docs-toc">
						<div class="toc-label">On this page</div>
						<div class="toc-list-wrap">
							<div class="toc-indicator"></div>
							<ul>
								{toc.map((entry) => (
									<li>
										<a href={`#${entry.id}`}>{entry.label}</a>
									</li>
								))}
							</ul>
						</div>
					</aside>
				)
			}
		</div>

		<script>
			function updateActiveNavLinks() {
				const pathname = location.pathname.replace(/\/$/, "") || "/";
				document.querySelectorAll(".docs-sidebar a, .docs-tab").forEach((link) => {
					const href = link.getAttribute("href");
					if (!href) return;
					link.classList.toggle("active", href.replace(/\/$/, "") === pathname);
				});
			}

			let cleanupTocScrollSpy = () => {};

			function setupTocScrollSpy() {
				cleanupTocScrollSpy();

				const tocLinks = [...document.querySelectorAll(".docs-toc a")];
				const headings = tocLinks
					.map((link) => document.getElementById(link.getAttribute("href").slice(1)))
					.filter((heading) => heading !== null);
				if (!headings.length) return;

				const triggerLine = 112;
				const indicator = document.querySelector(".toc-indicator");
				let isClickScrolling = false;
				let clickScrollTimer = null;

				const setActive = (id) => {
					let activeLink = null;
					tocLinks.forEach((link) => {
						const isActive = link.getAttribute("href") === `#${id}`;
						link.classList.toggle("active", isActive);
						if (isActive) activeLink = link;
					});
					if (indicator && activeLink) {
						indicator.style.transform = `translateY(${activeLink.offsetTop}px)`;
						indicator.style.height = `${activeLink.offsetHeight}px`;
					}
				};

				const onScroll = () => {
					if (isClickScrolling) {
						clearTimeout(clickScrollTimer);
						clickScrollTimer = setTimeout(() => {
							isClickScrolling = false;
						}, 100);
						return;
					}
					let current = headings[0];
					for (const heading of headings) {
						if (heading.getBoundingClientRect().top <= triggerLine) current = heading;
					}
					setActive(current.id);
				};

				const onLinkClick = (event) => {
					isClickScrolling = true;
					setActive(event.currentTarget.getAttribute("href").slice(1));
				};

				document.addEventListener("scroll", onScroll, { passive: true });
				tocLinks.forEach((link) => link.addEventListener("click", onLinkClick));
				onScroll();

				cleanupTocScrollSpy = () => {
					clearTimeout(clickScrollTimer);
					document.removeEventListener("scroll", onScroll);
					tocLinks.forEach((link) => link.removeEventListener("click", onLinkClick));
				};
			}

			document.addEventListener("astro:page-load", () => {
				updateActiveNavLinks();
				setupTocScrollSpy();
			});
		</script>
	</body>
</html>

<style>
	.docs-body {
		display: flex;
		align-items: flex-start;
		width: 100%;
		max-width: 90rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
		gap: var(--space-lg);
	}

	.docs-sidebar {
		flex: none;
		width: 15rem;
		position: sticky;
		top: 5.5rem;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
		padding-block: var(--space-md);
	}

	.docs-sidebar summary {
		cursor: pointer;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
		padding: 0.4rem 0.5rem;
		list-style: none;
	}

	.docs-sidebar summary::-webkit-details-marker {
		display: none;
	}

	.docs-sidebar summary::before {
		content: "▾ ";
	}

	.docs-sidebar details:not([open]) summary::before {
		content: "▸ ";
	}

	.docs-sidebar ul {
		list-style: none;
		padding: 0;
		margin: 0 0 var(--space-xs);
	}

	.docs-sidebar a {
		display: block;
		padding: 0.4rem 0.6rem 0.4rem 1.25rem;
		border-radius: 6px;
		font-size: var(--text-sm);
		color: var(--color-muted);
		text-decoration: none;
	}

	.docs-sidebar a:hover {
		color: var(--color-text);
	}

	.docs-sidebar a.active {
		color: var(--color-text);
		font-weight: 600;
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
	}

	.docs-content {
		flex: 1;
		min-width: 0;
		max-width: 42rem;
		padding-block: var(--space-lg);
	}

	.breadcrumb {
		font-size: var(--text-sm);
		color: var(--color-muted);
		margin-bottom: var(--space-sm);
	}

	.breadcrumb .sep {
		margin-inline: 0.4rem;
	}

	.breadcrumb .current {
		color: var(--color-text);
	}

	.docs-article :global(h1) {
		font-size: var(--text-2xl);
		margin-bottom: var(--space-xs);
	}

	.docs-article :global(p.lead) {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-bottom: var(--space-md);
	}

	.docs-article :global(h2) {
		font-size: var(--text-lg);
		font-family: var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-block: var(--space-md) var(--space-sm);
	}

	.docs-article :global(p) {
		margin-bottom: var(--space-sm);
		color: var(--color-muted);
		line-height: 1.7;
	}

	.docs-article :global(ul) {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin-bottom: var(--space-sm);
	}

	.docs-article :global(ul li) {
		padding: 0.5rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.docs-article :global(ul li::before) {
		content: "✓ ";
		color: var(--color-accent);
		font-weight: 700;
	}

	.docs-article :global(pre) {
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		padding: var(--space-sm);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: 1.8;
		overflow-x: auto;
		margin-bottom: var(--space-sm);
	}

	.docs-article :global(ol) {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		counter-reset: step;
		margin-bottom: var(--space-sm);
	}

	.docs-article :global(ol li) {
		display: flex;
		gap: var(--space-sm);
		align-items: baseline;
		padding: 0.6rem 0.75rem;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		font-size: var(--text-sm);
		color: var(--color-muted);
		counter-increment: step;
	}

	.docs-article :global(ol li::before) {
		content: counter(step);
		flex: none;
		width: 1.4rem;
		height: 1.4rem;
		border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text);
	}

	.docs-article :global(strong) {
		color: var(--color-text);
	}

	.pager {
		display: flex;
		gap: var(--space-sm);
		margin-top: var(--space-lg);
	}

	.pager-link {
		flex: 1;
		padding: 0.75rem 1rem;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.pager-link:hover {
		border-color: color-mix(in srgb, var(--color-text) 20%, transparent);
	}

	.pager-link.next {
		text-align: right;
		align-items: flex-end;
	}

	.pager-label {
		font-size: 0.6875rem;
		color: var(--color-muted);
	}

	.pager-title {
		font-size: var(--text-sm);
		color: var(--color-text);
		font-weight: 600;
	}

	.docs-toc {
		flex: none;
		width: 11rem;
		position: sticky;
		top: 5.5rem;
		padding-block: var(--space-lg);
		align-self: flex-start;
	}

	.toc-label {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: var(--space-xs);
	}

	.docs-toc ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.toc-list-wrap {
		position: relative;
	}

	.toc-list-wrap::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	.toc-indicator {
		position: absolute;
		left: 0;
		top: 0;
		width: 2px;
		background: var(--color-accent);
		transition:
			transform 0.2s ease,
			height 0.2s ease;
	}

	.docs-toc a {
		display: block;
		padding: 0.3rem 0 0.3rem 0.6rem;
		font-size: 0.8125rem;
		color: var(--color-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.docs-toc a.active {
		color: var(--color-text);
		font-weight: 600;
	}

	@media (max-width: 68rem) {
		.docs-toc {
			display: none;
		}
	}

	@media (max-width: 48rem) {
		.docs-body {
			flex-direction: column;
		}

		.docs-sidebar {
			position: static;
			width: 100%;
			max-height: none;
		}

		.docs-content {
			max-width: none;
		}
	}
</style>

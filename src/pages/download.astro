---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const windowsFormats = [
	{ id: "msi", label: "msi installer", size: "44 MB", icon: "lucide:package" },
	{ id: "zip", label: "zip portable", size: "42 MB", icon: "lucide:file-archive" },
];

const linuxFormats = [
	{ id: "targz", label: "tar.gz", size: "46 MB", icon: "lucide:file-archive" },
	{ id: "deb", label: "deb", size: "45 MB", icon: "lucide:package" },
	{ id: "rpm", label: "rpm", size: "45 MB", icon: "lucide:package" },
	{ id: "flatpak", label: "flatpak", size: "50 MB", icon: "lucide:box" },
	{ id: "appimage", label: "AppImage", size: "47 MB", icon: "lucide:app-window" },
];
---

<Layout title="Download Enzo">
	<main>
		<div class="hero">
			<div class="hero-backdrop-clip">
				<div class="hero-backdrop"></div>
			</div>
			<div class="hero-inner">
				<h1>Download Enzo</h1>
				<p>Free and open source procedural modelling.</p>
			</div>

			<div class="download-inner">
				<div class="dl-main-wrap" data-dl-root>
					<a href="#" class="dl-main">
						<span class="dl-icon"><Icon name="lucide:download" /></span>
						<span class="dl-title">Download for <span data-field="osName">Windows</span></span>
					</a>
					<p class="dl-meta"><Icon name="simple-icons:linux" /> v0.1.0-alpha · <span data-field="formatLabel"></span> · <span data-field="formatSize"></span></p>
				</div>
				<a href="#" class="source-link">Build from source →</a>
			</div>
		</div>

		<section id="releases">
			<div class="section-inner">
				<h2 class="section-label">RELEASES</h2>
				<div class="releases-grid">
					<div class="release-card build-card">
						<h3><Icon name="simple-icons:windows" /> Windows</h3>
						<div class="builds-rows">
							{windowsFormats.map((f) => (
								<div class="build-row">
									<span class="build-label"><Icon name={f.icon} /> {f.label}</span>
									<span class="build-download" aria-hidden="true"><Icon name="lucide:download" /></span>
								</div>
							))}
						</div>
					</div>
					<div class="release-card build-card">
						<h3><Icon name="simple-icons:linux" /> Linux</h3>
						<div class="builds-rows">
							{linuxFormats.map((f) => (
								<div class="build-row">
									<span class="build-label"><Icon name={f.icon} /> {f.label}</span>
									<span class="build-download" aria-hidden="true"><Icon name="lucide:download" /></span>
								</div>
							))}
						</div>
					</div>
					<a href="https://github.com/parkerbritt/enzo/releases/latest" target="_blank" rel="noopener" class="release-card">
						<h3><Icon name="lucide:file-text" /> Release notes</h3>
						<p>See what changed in v0.1.0-alpha.</p>
					</a>
					<a href="https://github.com/parkerbritt/enzo/releases" target="_blank" rel="noopener" class="release-card">
						<h3><Icon name="lucide:history" /> All versions</h3>
						<p>Browse every release, including older builds.</p>
					</a>
				</div>
			</div>
		</section>

		<section id="requirements">
			<div class="section-inner">
				<h2 class="section-label">SYSTEM REQUIREMENTS</h2>
				<div class="requirements-grid">
					<div class="requirement">
						<h3>Windows</h3>
						<ul>
							<li>Windows 10 or 11, 64-bit</li>
							<li>GPU supporting OpenGL 3.3</li>
							<li>4 GB RAM minimum, 16 GB recommended</li>
							<li>~500 MB disk space</li>
						</ul>
					</div>
					<div class="requirement">
						<h3>Linux</h3>
						<ul>
							<li>A modern 64-bit distro (Ubuntu 22.04+ or equivalent)</li>
							<li>X11 or Wayland, GPU supporting OpenGL 3.3</li>
							<li>4 GB RAM minimum, 16 GB recommended</li>
							<li>~500 MB disk space</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		position: relative;
		z-index: 1;

		/* Dot grid, matching Hero.astro on the homepage. */
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-text) 15%, transparent) 1px,
			transparent 1.5px
		);
		background-size: 35px 35px;
		background-attachment: fixed;
	}

	/* Clips only the blurred backdrop's bleed, so the dropdown (a sibling) can still overflow the hero and stack above later sections. */
	.hero-backdrop-clip {
		position: absolute;
		inset: -12px;
		z-index: -1;
		overflow: clip;
	}

	.hero-backdrop {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(180deg, color-mix(in srgb, var(--color-bg) 35%, transparent) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 45%, var(--color-bg) 100%),
			url("/images/download-hero-banner.png");
		background-size: cover;
		background-position: center 35%;
		filter: blur(10px);
		opacity: 0.5;
	}

	.hero-inner {
		max-width: 70rem;
		margin: 0 auto;
		padding: var(--space-xl) var(--space-md) var(--space-xs);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-xs);
	}

	.hero-inner h1 {
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
	}

	.hero-inner p {
		margin: 0;
		max-width: 30rem;
		color: var(--color-bold);
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
	}

	.download-inner {
		max-width: 70rem;
		margin: 0 auto;
		padding: var(--space-md) var(--space-md) var(--space-xl);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}

	.dl-main-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}

	.dl-main {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-sm);
		padding: var(--space-sm) var(--space-md);
		border-radius: 14px;
		background: var(--color-accent);
		color: #fff;
		min-width: 19rem;
		text-decoration: none;
	}

	.dl-icon {
		display: flex;
		flex: none;
	}

	.dl-icon :global(svg) {
		width: 20px;
		height: 20px;
	}

	.dl-title {
		font-size: var(--text-lg);
		font-weight: 700;
	}

	.dl-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.8125rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
	}

	.dl-meta :global(svg) {
		width: 13px;
		height: 13px;
	}

	.source-link {
		font-size: 0.8125rem;
		color: var(--color-muted);
	}

	main {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	#requirements {
		border-top: none;
		flex: 1;
		padding-top: var(--space-xl);
	}

	.releases-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		margin-top: var(--space-md);
	}

	.release-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-md);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: color-mix(in srgb, black 18%, transparent);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	a.release-card:hover {
		border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
	}

	.release-card h3 {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		font-size: var(--text-sm);
		font-weight: 600;
		margin-bottom: var(--space-xs);
	}

	.release-card h3 :global(svg) {
		width: 14px;
		height: 14px;
	}

	.release-card p {
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.build-card .builds-rows {
		margin-top: var(--space-xs);
	}

	.build-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 0.5rem;
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
		font-size: var(--text-sm);
		cursor: pointer;
	}

	.build-label {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.build-label :global(svg) {
		width: 15px;
		height: 15px;
		color: var(--color-muted);
		flex: none;
	}

	.build-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.build-download {
		display: flex;
		color: var(--color-muted);
		transition: color 0.15s ease;
	}

	.build-download :global(svg) {
		width: 15px;
		height: 15px;
	}

	.build-row:hover .build-download {
		color: var(--color-accent);
	}

	.requirements-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		margin-top: var(--space-md);
	}

	.requirement h3 {
		font-size: var(--text-sm);
		font-weight: 600;
		margin-bottom: var(--space-sm);
	}

	.requirement ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.requirement li {
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.requirement + .requirement {
		padding-left: var(--space-md);
		border-left: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	@media (max-width: 40rem) {
		.releases-grid {
			grid-template-columns: 1fr;
		}

		.requirements-grid {
			grid-template-columns: 1fr;
		}

		.requirement + .requirement {
			padding-left: 0;
			border-left: none;
			padding-top: var(--space-md);
			border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		}

		.dl-main {
			min-width: 0;
		}
	}
</style>

<script>
	// Kept in sync with the recommended entry in windowsFormats/linuxFormats above.
	const RECOMMENDED = {
		windows: { label: "msi installer", size: "44 MB" },
		linux: { label: "tar.gz", size: "46 MB" },
	};

	const root = document.querySelector<HTMLElement>("[data-dl-root]");
	if (root) {
		const osNameEl = root.querySelector<HTMLElement>('[data-field="osName"]')!;
		const formatLabelEl = root.querySelector<HTMLElement>('[data-field="formatLabel"]')!;
		const formatSizeEl = root.querySelector<HTMLElement>('[data-field="formatSize"]')!;

		const detectOS = (): "windows" | "linux" => {
			const ua = `${navigator.userAgent} ${navigator.platform}`;
			return /linux/i.test(ua) && !/android/i.test(ua) ? "linux" : "windows";
		};

		const os = detectOS();
		osNameEl.textContent = os === "linux" ? "Linux" : "Windows";
		formatLabelEl.textContent = RECOMMENDED[os].label;
		formatSizeEl.textContent = RECOMMENDED[os].size;
	}
</script>

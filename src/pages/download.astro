---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const RELEASES_URL = "https://github.com/parkerbritt/enzo/releases";

type ReleaseAsset = { name: string; size: number; browser_download_url: string };
type Release = { tag_name: string; html_url: string; assets: ReleaseAsset[] };

/** Returns the latest enzo release, or null when the request fails. */
async function fetchLatestRelease(): Promise<Release | null> {
	try {
		const res = await fetch("https://api.github.com/repos/parkerbritt/enzo/releases/latest", {
			headers: { Accept: "application/vnd.github+json" },
		});
		if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);
		return await res.json();
	} catch (err) {
		console.warn(`Could not fetch the latest enzo release, download links point at the releases page. ${err}`);
		return null;
	}
}

const release = await fetchLatestRelease();
const version = release?.tag_name ?? "latest";

/** Returns the download link and size for the release file whose name ends with the given suffix. */
function findAsset(suffix: string) {
	const asset = release?.assets.find((a) => a.name.endsWith(suffix));
	if (!asset) return { url: `${RELEASES_URL}/latest`, size: "" };
	return { url: asset.browser_download_url, size: `${Math.round(asset.size / 1024 / 1024)} MB` };
}

// Lists the platforms offered for download. The first is shown until the visitor's system is detected.
const platforms = [
	{
		id: "windows",
		name: "Windows",
		icon: "simple-icons:windows",
		recommended: "exe",
		formats: [
			{ id: "exe", label: "exe installer", icon: "lucide:package", ...findAsset("-windows-AMD64.exe") },
			{ id: "msi", label: "msi installer", icon: "lucide:package", ...findAsset("-windows-AMD64.msi") },
			{ id: "zip", label: "zip portable", icon: "lucide:file-archive", ...findAsset("-windows-AMD64.zip") },
		],
	},
	{
		id: "linux",
		name: "Linux",
		icon: "simple-icons:linux",
		recommended: "targz",
		formats: [
			{ id: "appimage", label: "AppImage", icon: "lucide:app-window", ...findAsset("-linux-x86_64.AppImage") },
			{ id: "targz", label: "tar.gz", icon: "lucide:file-archive", ...findAsset("-linux-x86_64.tar.gz") },
			{ id: "deb", label: "deb", icon: "lucide:package", ...findAsset("-linux-x86_64.deb") },
			{ id: "rpm", label: "rpm", icon: "lucide:package", ...findAsset("-linux-x86_64.rpm") },
		],
	},
];

// Maps each platform id to the download the main button offers.
const mainDownloads = Object.fromEntries(
	platforms.map((p) => {
		const format = p.formats.find((f) => f.id === p.recommended)!;
		const meta = [version, format.label, format.size].filter(Boolean).join(" · ");
		return [p.id, { url: format.url, name: p.name, meta }];
	}),
);
const initial = mainDownloads[platforms[0].id];
---

<Layout title="Download Enzo">
	<main>
		<div class="hero">
			<div class="hero-backdrop-clip">
				<div class="hero-backdrop"></div>
			</div>
			<div class="hero-inner">
				<h1>Download Enzo</h1>
				<p>Free and open source procedural modelling.</p>
			</div>

			<div class="download-inner">
				<div class="dl-main-wrap" data-dl-root data-downloads={JSON.stringify(mainDownloads)}>
					<a href={initial.url} class="dl-main" data-field="url">
						<span class="dl-icon"><Icon name="lucide:download" /></span>
						<span class="dl-title">Download for <span data-field="name">{initial.name}</span></span>
					</a>
					<p class="dl-meta">
						{platforms.map((p, i) => (
							<span class="dl-os-icon" data-os-icon={p.id} hidden={i > 0}><Icon name={p.icon} /></span>
						))}
						<span data-field="meta">{initial.meta}</span>
					</p>
				</div>
			</div>

			<div class="dl-thanks-backdrop" data-dl-thanks hidden>
				<div class="dl-thanks-modal" role="dialog" aria-modal="true" aria-labelledby="dl-thanks-title">
					<button type="button" class="dl-thanks-close" data-dl-thanks-close aria-label="Close">
						<Icon name="lucide:x" />
					</button>
					<span class="dl-thanks-icon"><Icon name="lucide:sticker" /></span>
					<h2 id="dl-thanks-title">Thank you for trying Enzo!</h2>
					<p>
						Enzo is a small passion project mostly built by one person, so expect some bugs and slower
						development than a bigger team could offer. Bug reports and patience are both very
						appreciated.
					</p>
					<div class="dl-thanks-contact">
						<span class="dl-thanks-contact-email">
							<Icon name="lucide:mail" />
							<span>parker@parkerbritt.com</span>
						</span>
						<a href="https://github.com/parkerbritt/enzo/issues" target="_blank" rel="noopener">
							<Icon name="lucide:circle-dot" />
							<span>Report an issue</span>
						</a>
					</div>
				</div>
			</div>
		</div>

		<section id="releases">
			<div class="section-inner">
				<p class="section-eyebrow">{version}</p>
				<h2 class="section-label">RELEASES</h2>
				<div class="releases-grid">
					{platforms.map((p) => (
						<div class="release-card build-card">
							<h3><Icon name={p.icon} /> {p.name}</h3>
							<div class="builds-rows">
								{p.formats.map((f) => (
									<a href={f.url} class="build-row">
										<span class="build-label"><Icon name={f.icon} /> {f.label}</span>
										<span class="build-download" aria-hidden="true"><Icon name="lucide:download" /></span>
									</a>
								))}
							</div>
						</div>
					))}
					<a href={release?.html_url ?? `${RELEASES_URL}/latest`} target="_blank" rel="noopener" class="release-card">
						<h3><Icon name="lucide:file-text" /> Release notes</h3>
						<p>See what changed in {version}.</p>
					</a>
					<a href={RELEASES_URL} target="_blank" rel="noopener" class="release-card">
						<h3><Icon name="lucide:history" /> All versions</h3>
						<p>Browse every release, including older builds.</p>
					</a>
				</div>
			</div>
		</section>

		<section id="requirements">
			<div class="section-inner">
				<h2 class="section-label">SYSTEM REQUIREMENTS</h2>
				<div class="requirements-grid">
					<div class="requirement">
						<h3>Windows</h3>
						<ul>
							<li>Windows 10 or 11, 64-bit</li>
							<li>GPU supporting OpenGL 3.3</li>
							<li>4 GB RAM minimum, 16 GB recommended</li>
							<li>~500 MB disk space</li>
						</ul>
					</div>
					<div class="requirement">
						<h3>Linux</h3>
						<ul>
							<li>A modern 64-bit distro (Ubuntu 22.04+ or equivalent)</li>
							<li>X11 or Wayland, GPU supporting OpenGL 3.3</li>
							<li>4 GB RAM minimum, 16 GB recommended</li>
							<li>~500 MB disk space</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		position: relative;
		z-index: 1;

		/* Dot grid, matching Hero.astro on the homepage. */
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-text) 15%, transparent) 1px,
			transparent 1.5px
		);
		background-size: 35px 35px;
		background-attachment: fixed;
	}

	/* Clips only the blurred backdrop's bleed, so the dropdown (a sibling) can still overflow the hero and stack above later sections. */
	.hero-backdrop-clip {
		position: absolute;
		inset: -12px;
		z-index: -1;
		overflow: clip;
	}

	.hero-backdrop {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(180deg, color-mix(in srgb, var(--color-bg) 35%, transparent) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 45%, var(--color-bg) 100%),
			url("/images/download-hero-banner.png");
		background-size: cover;
		background-position: center 35%;
		filter: blur(10px);
		opacity: 0.5;
	}

	.hero-inner {
		max-width: 70rem;
		margin: 0 auto;
		padding: var(--space-xl) var(--space-md) var(--space-xs);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-xs);
	}

	.hero-inner h1 {
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
	}

	.hero-inner p {
		margin: 0;
		max-width: 30rem;
		color: var(--color-bold);
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
	}

	.download-inner {
		max-width: 70rem;
		margin: 0 auto;
		padding: var(--space-md) var(--space-md) var(--space-xl);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}

	.dl-main-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
	}

	.dl-main {
		position: relative;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-sm);
		padding: var(--space-sm) var(--space-md);
		border-radius: 14px;
		background: var(--color-accent);
		color: #fff;
		min-width: 19rem;
		text-decoration: none;
		transition: transform 0.15s ease;
	}

	.dl-main:hover {
		transform: scale(1.02);
	}

	.dl-main.dl-pop {
		animation: dl-pop 0.4s ease;
	}

	@keyframes dl-pop {
		0% {
			transform: scale(1);
		}
		35% {
			transform: scale(1.08);
		}
		100% {
			transform: scale(1);
		}
	}

	.dl-icon {
		display: flex;
		flex: none;
	}

	.dl-icon :global(svg) {
		width: 20px;
		height: 20px;
	}

	.dl-title {
		font-size: var(--text-lg);
		font-weight: 700;
	}

	.dl-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.8125rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
	}

	.dl-os-icon {
		display: flex;
	}

	.dl-os-icon[hidden] {
		display: none;
	}

	.dl-meta :global(svg) {
		width: 13px;
		height: 13px;
	}

	.dl-thanks-backdrop {
		position: fixed;
		inset: 0;
		z-index: 2000;
		align-items: center;
		justify-content: center;
		padding: var(--space-md);
		background: rgba(0, 0, 0, 0.5);
	}

	.dl-thanks-backdrop:not([hidden]) {
		display: flex;
	}

	.dl-thanks-modal {
		position: relative;
		max-width: 26rem;
		width: 100%;
		padding: var(--space-lg) var(--space-md) var(--space-md);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-bg);
		color: var(--color-text);
	}

	.dl-thanks-icon {
		display: flex;
		justify-content: center;
		width: 4.0rem;
		height: 4.0rem;
		margin: 0 auto var(--space-sm);
		color: var(--color-accent);
	}

	.dl-thanks-icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.dl-thanks-modal h2 {
		font-size: var(--text-lg);
		margin-bottom: var(--space-sm);
		text-align: center;
	}

	.dl-thanks-modal p {
		font-size: var(--text-sm);
		color: var(--color-muted);
		text-align: justify;
	}

	.dl-thanks-contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
		margin-top: var(--space-sm);
		padding-top: var(--space-sm);
		border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	.dl-thanks-contact a,
	.dl-thanks-contact-email {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		font-size: var(--text-sm);
		color: var(--color-muted);
		text-decoration: none;
	}

	.dl-thanks-contact a:hover {
		color: var(--color-text);
	}

	.dl-thanks-contact :global(svg) {
		width: 14px;
		height: 14px;
		flex: none;
	}

	.dl-thanks-close {
		position: absolute;
		top: var(--space-sm);
		right: var(--space-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border: none;
		border-radius: 8px;
		background: none;
		color: var(--color-muted);
		cursor: pointer;
	}

	.dl-thanks-close:hover {
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
		color: var(--color-text);
	}

	.dl-thanks-close :global(svg) {
		width: 16px;
		height: 16px;
	}

	main {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	#requirements {
		border-top: none;
		flex: 1;
		padding-top: var(--space-xl);
		padding-bottom: var(--space-xl);
	}

	.releases-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		margin-top: var(--space-md);
	}

	.section-eyebrow {
		font-family: var(--font-mono);
		color: var(--color-muted);
	}

	.release-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-md);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: color-mix(in srgb, black 18%, transparent);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	a.release-card:hover {
		border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
	}

	.release-card h3 {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		font-size: var(--text-sm);
		font-weight: 600;
		margin-bottom: var(--space-xs);
	}

	.release-card h3 :global(svg) {
		width: 14px;
		height: 14px;
	}

	.build-card h3 {
		gap: calc(var(--space-sm));
	}

	.build-card h3 :global(svg) {
		width: 22px;
		height: 22px;
	}

	.release-card p {
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.build-card .builds-rows {
		margin-top: var(--space-xs);
	}

	.build-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 0.5rem;
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
		font-size: var(--text-sm);
		color: var(--color-text);
		text-decoration: none;
	}

	.build-label {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.build-label :global(svg) {
		width: 15px;
		height: 15px;
		color: var(--color-muted);
		flex: none;
	}

	.build-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.build-download {
		display: flex;
		color: var(--color-muted);
		transition: color 0.15s ease;
	}

	.build-download :global(svg) {
		width: 15px;
		height: 15px;
	}

	.build-row:hover .build-download {
		color: var(--color-accent);
	}

	.requirements-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		margin-top: var(--space-md);
	}

	.requirement h3 {
		font-size: var(--text-sm);
		font-weight: 600;
		margin-bottom: var(--space-sm);
	}

	.requirement ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.requirement li {
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.requirement + .requirement {
		padding-left: var(--space-md);
		border-left: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	@media (max-width: 40rem) {
		.releases-grid {
			grid-template-columns: 1fr;
		}

		.requirements-grid {
			grid-template-columns: 1fr;
		}

		.requirement + .requirement {
			padding-left: 0;
			border-left: none;
			padding-top: var(--space-md);
			border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		}

		.dl-main {
			min-width: 0;
		}
	}
</style>

<script>
	let showThanksModal = () => {};

	const thanksBackdrop = document.querySelector<HTMLElement>("[data-dl-thanks]");
	if (thanksBackdrop) {
		const hideThanksModal = () => {
			thanksBackdrop.hidden = true;
		};
		showThanksModal = () => {
			thanksBackdrop.hidden = false;
		};

		thanksBackdrop.querySelector("[data-dl-thanks-close]")!.addEventListener("click", hideThanksModal);
		thanksBackdrop.addEventListener("click", (e) => {
			if (e.target === thanksBackdrop) hideThanksModal();
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !thanksBackdrop.hidden) hideThanksModal();
		});
	}

	const root = document.querySelector<HTMLElement>("[data-dl-root]");
	if (root) {
		const detectOS = (): "windows" | "linux" => {
			const ua = `${navigator.userAgent} ${navigator.platform}`;
			return /linux/i.test(ua) && !/android/i.test(ua) ? "linux" : "windows";
		};

		// Points the main button at the recommended download for this system.
		const os = detectOS();
		const download: { url: string; name: string; meta: string } = JSON.parse(root.dataset.downloads!)[os];
		root.querySelector<HTMLAnchorElement>('[data-field="url"]')!.href = download.url;
		root.querySelector<HTMLElement>('[data-field="name"]')!.textContent = download.name;
		root.querySelector<HTMLElement>('[data-field="meta"]')!.textContent = download.meta;
		root.querySelectorAll<HTMLElement>("[data-os-icon]").forEach((el) => {
			el.hidden = el.dataset.osIcon !== os;
		});

		const mainButton = root.querySelector<HTMLAnchorElement>(".dl-main")!;
		mainButton.addEventListener("click", () => {
			mainButton.classList.remove("dl-pop");
			// Restart the animation even if it's already mid-run.
			void mainButton.offsetWidth;
			mainButton.classList.add("dl-pop");
			burstConfetti(mainButton);
			// There's no way to detect whether the browser's save dialog was actually
			// confirmed, so this assumes the download went through after a short delay.
			window.setTimeout(showThanksModal, 2500);
		});
	}

	/** Fires a canvas confetti burst from the center of the given element. */
	function burstConfetti(origin: HTMLElement) {
		const colors = ["#f94144", "#f9c74f", "#90be6d", "#577590", "#f3722c", "#43aa8b"];
		const rect = origin.getBoundingClientRect();
		const originX = rect.left + rect.width / 2;
		const originY = rect.top + rect.height / 2;

		const canvas = document.createElement("canvas");
		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;
		canvas.style.position = "fixed";
		canvas.style.inset = "0";
		canvas.style.pointerEvents = "none";
		canvas.style.zIndex = "999"; // Stays under the button (z-index 1000) so the confetti passes behind it.
		// Placed inside .hero, which owns its own stacking context (position: relative; z-index: 1) —
		// appending to body would compare the canvas against that whole context instead of the button.
		(origin.closest<HTMLElement>(".hero") ?? document.body).appendChild(canvas);
		const ctx = canvas.getContext("2d")!;

		const gravity = 0.18;
		const drag = 0.994;
		const particles = Array.from({ length: 90 }, () => {
			const angle = Math.random() * Math.PI * 2;
			const speed = 4 + Math.random() * 9;
			return {
				x: originX,
				y: originY,
				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed - 4,
				size: 5 + Math.random() * 5,
				color: colors[Math.floor(Math.random() * colors.length)],
				rotation: Math.random() * Math.PI * 2,
				rotationSpeed: (Math.random() - 0.5) * 0.3,
				life: 0,
				maxLife: 60 + Math.random() * 30,
			};
		});

		let frame: number;
		const tick = () => {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			let alive = false;
			for (const p of particles) {
				p.life++;
				if (p.life > p.maxLife) continue;
				alive = true;
				p.vx *= drag;
				p.vy = p.vy * drag + gravity;
				p.x += p.vx;
				p.y += p.vy;
				p.rotation += p.rotationSpeed;

				const fade = 1 - p.life / p.maxLife;
				ctx.save();
				ctx.globalAlpha = fade;
				ctx.translate(p.x, p.y);
				ctx.rotate(p.rotation);
				ctx.fillStyle = p.color;
				ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
				ctx.restore();
			}
			if (alive) {
				frame = requestAnimationFrame(tick);
			} else {
				cancelAnimationFrame(frame);
				canvas.remove();
			}
		};
		frame = requestAnimationFrame(tick);
	}
</script>

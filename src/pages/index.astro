---
import Layout from "../layouts/Layout.astro";

const features = [
	{
		title: "Free & Open Source",
		description: "GPL-3.0. No subscriptions, seat limits, or licensing keys.",
		placeholder: "GitHub stats",
	},
	{
		title: "Unified Context",
		description: "Copy cameras to points. One context, no mode switching.",
		placeholder: "Screenshot",
	},
	{
		title: "Modular Engine",
		description: "Embed in a game, run headlessly. Lives outside the UI.",
		placeholder: "Diagram",
	},
	{
		title: "DasLang Scripting",
		description: "Expressions in any parameter. Drive @pscale from noise().",
		placeholder: "Code snippet",
	},
	{
		title: "Lightweight",
		description: "Launches in under a second.",
		placeholder: "0.8s stat",
	},
];
---

<Layout title="Enzo">
	<main>
		<div class="hero">
			<div class="section-inner hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">v0.1.0-alpha</p>
					<h1>Enzo</h1>
					<h2>Procedural Modelling</h2>
					<p class="lead">
						Free, open source 3D procedural modeling. No licensing, no
						subscriptions.
					</p>
					<div class="actions">
						<button class="primary">Getting Started</button>
						<button>Download</button>
					</div>
				</div>
				<div class="hero-media">
					<span>Video Placeholder</span>
				</div>
			</div>
		</div>

		<section>
			<div class="section-inner"><h2 class="section-label">WHAT IS ENZO</h2></div>
		</section>
		<section id="features">
			<div class="section-inner">
				<h2 class="section-label">FEATURES</h2>
				<div class="features">
					{
						features.map((feature) => (
							<div class="feature-row">
								<div class="feature-copy">
									<h3>{feature.title}</h3>
									<p>{feature.description}</p>
								</div>
								<div class="feature-media">
									<span>{feature.placeholder}</span>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>
		<section>
			<div class="section-inner"><h2 class="section-label">WHY ENZO</h2></div>
		</section>
		<section>
			<div class="section-inner"><h2 class="section-label">ROADMAP</h2></div>
		</section>
		<section>
			<div class="section-inner"><h2 class="section-label">FAQ</h2></div>
		</section>
	</main>
</Layout>

<style>
	.section-inner {
		max-width: 70rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
	}

	.hero {
		padding-block: var(--space-lg);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-lg);
		align-items: center;
	}

	.hero-media {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}

	@media (max-width: 48rem) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Every other section gets a lighter background so you can tell them apart. */
	section {
		padding-block: var(--space-lg);
	}

	section:nth-of-type(odd) {
		background: var(--color-panel);
	}

	.eyebrow {
		font-family: var(--font-mono);
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.lead {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-top: var(--space-sm);
		max-width: 32rem;
	}

	.actions {
		display: flex;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}

	button {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		padding: var(--space-xs) var(--space-md);
		border: 1px solid var(--color-muted);
		border-radius: 6px;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	button.primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
		font-weight: 700;
	}

	.section-label {
		font-family: var(--font-mono);
		color: var(--color-muted);
	}

	.features {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: var(--space-md);
	}

	.feature-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		align-items: center;
	}

	/* Alternate which side the screenshot sits on for a zig-zag layout. */
	.feature-row:nth-child(even) .feature-copy {
		order: 2;
	}

	/* Copy and screenshot share the same width and both hug their outer edge,
	   so text and images line up on the same gridlines across every row. */
	.feature-copy,
	.feature-media {
		width: 100%;
		max-width: 28rem;
	}

	.feature-copy {
		justify-self: start;
	}

	.feature-row:nth-child(even) .feature-copy {
		justify-self: end;
	}

	.feature-row:nth-child(even) .feature-media {
		justify-self: start;
	}

	.feature-copy h3 {
		font-size: var(--text-xl);
		font-weight: 700;
	}

	.feature-copy p {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-top: var(--space-sm);
	}

	.feature-media {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		justify-self: end;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}

	@media (max-width: 48rem) {
		.feature-row {
			grid-template-columns: 1fr;
		}

		/* Keep copy above the screenshot on every row when stacked. */
		.feature-row:nth-child(even) .feature-copy {
			order: 0;
		}
	}
</style>

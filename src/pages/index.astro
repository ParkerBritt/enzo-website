---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Enzo">
	<main>
		<div class="hero">
			<div class="section-inner hero-grid">
				<div class="hero-copy">
					<p class="eyebrow">v0.1.0-alpha</p>
					<h1>Enzo</h1>
					<h2>Procedural Modelling</h2>
					<p class="lead">
						Free, open source 3D procedural modeling. No licensing, no
						subscriptions.
					</p>
					<div class="actions">
						<button class="primary">Getting Started</button>
						<button>Download</button>
					</div>
				</div>
				<div class="hero-media">
					<span>Video Placeholder</span>
				</div>
			</div>
		</div>

		<section>
			<div class="section-inner"><h2 class="section-label">WHAT IS ENZO</h2></div>
		</section>
		<section id="features">
			<div class="section-inner"><h2 class="section-label">FEATURES</h2></div>
		</section>
		<section>
			<div class="section-inner"><h2 class="section-label">WHY ENZO</h2></div>
		</section>
		<section>
			<div class="section-inner"><h2 class="section-label">ROADMAP</h2></div>
		</section>
		<section>
			<div class="section-inner"><h2 class="section-label">FAQ</h2></div>
		</section>
	</main>
</Layout>

<style>
	.section-inner {
		max-width: 75rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
	}

	.hero {
		padding-block: var(--space-lg);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-lg);
		align-items: center;
	}

	.hero-media {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}

	@media (max-width: 48rem) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Every other section gets a lighter background so you can tell them apart. */
	section {
		padding-block: var(--space-lg);
	}

	section:nth-of-type(odd) {
		background: var(--color-panel);
	}

	.eyebrow {
		font-family: var(--font-mono);
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.lead {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-top: var(--space-sm);
		max-width: 32rem;
	}

	.actions {
		display: flex;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}

	button {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		padding: var(--space-xs) var(--space-md);
		border: 1px solid var(--color-muted);
		border-radius: 6px;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	button.primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
		font-weight: 700;
	}

	.section-label {
		font-family: var(--font-mono);
		color: var(--color-muted);
	}
</style>

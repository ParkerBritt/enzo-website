---
const features = [
	{
		title: "Free & Open Source",
        description: "GPL-3.0. No license manager/keys, subscriptions, seat limits, or cost to worry about.",
		placeholder: "GitHub stats",
	},
	{
		title: "Unified Context",
        description: "Copy lights to voxels, control focal length with noise. All your tools can be mixed and matched, without switching contexts.",
		placeholder: "Screenshot",
	},
	{
		title: "Modular Engine",
        description: "Completely portable. Embed in a game, run headlessly, or create your own frontend.",
		placeholder: "Diagram",
	},
	{
		title: "Scripting",
        description: "Control parameters with code using DasLang's high performance, rich feature set, and python-like syntax.",
		placeholder: "Code snippet",
	},
	{
		title: "Lightweight",
        // TODO: verify claim, back it up
        description: "Gui launches in under a second and running headless starts in nanoseconds.",
		placeholder: "0.8s stat",
	},
];
---

<section id="features">
	<div class="section-inner">
		<h2 class="section-label">FEATURES</h2>
		<div class="features">
			{
				features.map((feature) => (
					<div class="feature-row">
						<div class="feature-copy">
							<h3>{feature.title}</h3>
							<p>{feature.description}</p>
						</div>
						<div class="feature-media">
							<span>{feature.placeholder}</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
    h2 {
		padding-bottom: var(--space-xs);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    }

	.features {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: var(--space-md);
	}

	.feature-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
		align-items: center;
	}

	/* Alternate which side the screenshot sits on for a zig-zag layout. */
	.feature-row:nth-child(even) .feature-copy {
		order: 2;
	}

	/* Copy and screenshot share the same width and both hug their outer edge,
	   so text and images line up on the same gridlines across every row. */
	.feature-copy,
	.feature-media {
		width: 100%;
		max-width: 28rem;
	}

	.feature-copy {
		justify-self: start;
	}

	.feature-row:nth-child(even) .feature-copy {
		justify-self: end;
	}

	.feature-row:nth-child(even) .feature-media {
		justify-self: start;
	}

	.feature-copy h3 {
		font-size: var(--text-xl);
		font-weight: 700;
	}

	.feature-copy p {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-top: var(--space-sm);
	}

	.feature-media {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		justify-self: end;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}

	@media (max-width: 48rem) {
		.feature-row {
			grid-template-columns: 1fr;
		}

		/* Keep copy above the screenshot on every row when stacked. */
		.feature-row:nth-child(even) .feature-copy {
			order: 0;
		}
	}
</style>

<section>
	<div class="section-inner">
		<h2 class="section-label">WHAT IS ENZO?</h2>
		<div class="what">
			<div class="what-copy">
				<h3>Enzo is a node-based procedural modeling app.</h3>
				<p>
					Procedural modeling builds 3D geometry from a recipe of steps
					rather than shaping it by hand. It's built for making whole cities, detailed forests, sprawling
					terrain, or creating hundreds of variations of a single asset. Change one
                    control and the entire result changes, automatically.
				</p>
			</div>
			<div class="what-media">
				<span>Annotated node graph diagram</span>
			</div>
		</div>
	</div>
</section>

<style>
	.what {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: var(--space-md);
		align-items: center;
		margin-top: var(--space-md);
		padding-top: var(--space-md);
		border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	.what-copy h3 {
		font-size: var(--text-lg);
		font-weight: 700;
        color: var(--color-text);
	}

	.what-copy p {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-top: var(--space-sm);
	}

	.what-media {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
	}

	@media (max-width: 48rem) {
		.what {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import IconPeek from "./IconPeek.astro";
import VideoPlayer from "./VideoPlayer.astro";
---

<section>
	<div class="section-inner">
		<h2 class="section-label">WHAT IS <IconPeek text="ENZO?" icon="/icons/enzo.svg" offsetX="30px" /></h2>
		<div class="what">
            <VideoPlayer src="/videos/demo.mp4" aspectRatio="16 / 9"/>
			<div class="what-copy">
				<h3>Enzo is a node-based procedural modeling app.</h3>
				<p>
					Procedural modeling builds 3D geometry from a recipe of steps
					rather than shaping it by hand. It's built for making whole cities, detailed forests, sprawling
					terrain, or creating hundreds of variations of a single asset. Change one
                    control and the entire result changes, automatically.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
    section {
        padding-top: var(--space-lg);
        padding-bottom: var(--space-lg);
    }

    h2 {
		display: table;
		padding-bottom: var(--space-xs);
		margin-inline: auto;
		margin-bottom: var(--space-xs);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
        text-align: center;
    }

	.what {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		padding-top: var(--space-md);
	}

	.what-copy h3 {
		font-size: var(--text-lg);
		font-weight: 700;
        color: var(--color-text);
	}

	.what-copy p {
		color: var(--color-muted);
		font-size: var(--text-lg);
		margin-top: var(--space-sm);
		text-align: justify;
	}

</style>

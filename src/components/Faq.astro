---
const faqs = [
	{
		question: "Is Enzo ready for production use?",
        answer: "Not yet, Enzo is currently in early alpha meaning we're still getting the foudation solid before adding a lot of the nodes and features that make it comfortable to use. It's currently great to use for experimentation, but not production pipelines.",
		open: true,
	},
	{
		question: "What platforms are supported?",
        answer: "Currently the main target is Linux, while you should be able to compile on Windows and Mac they are not yet officially supported.",
	},
	{
		question: "Who is developing Enzo",
        answer: "Mostly just me, Parker Britt, working on it in my free time after work. It's a passion project I'm building because it's what I'd want to use, so there are no financial pressures to 'enshitify' the software. This, however, means I can only go at the pace one person can sustain.",
	},
	{
		question: "Can I use Enzo commercially?",
        answer: "Absolutely, Enzo is free and open source meaning you own the tools and anything you create with it.",
	},
	{
		question: "Can I contribute?",
        answer: "Enzo is open to contributions to those with experience. I'd just ask for no low effort AI contributions. To get started feel free to message me and we can find a good issue for you to work on.",
	},
];
---

<section id="faq">
	<div class="section-inner">
		<h2 class="section-label">FAQ</h2>
		<div class="faqs">
			{
				faqs.map((faq) => (
					<details class:list={["faq", { "is-open": faq.open }]} open={faq.open}>
						<summary>
							<span>{faq.question}</span>
							<span class="chevron" aria-hidden="true" />
						</summary>
						<div class="faq-content">
							<p>{faq.answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	h2 {
		padding-bottom: var(--space-xs);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	.faqs {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}

	.faq {
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: color-mix(in srgb, black 18%, transparent);
		overflow: hidden;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		padding: var(--space-sm) var(--space-md);
		font-size: var(--text-lg);
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.chevron {
		flex-shrink: 0;
		width: 0.6rem;
		height: 0.6rem;
		border-right: 2px solid var(--color-muted);
		border-bottom: 2px solid var(--color-muted);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	/* Chevron points up once the answer is expanded. */
	.faq.is-open .chevron {
		transform: rotate(225deg);
	}

	.faq-content {
		overflow: hidden;
		contain: layout paint;
	}

	.faq-content p {
		color: var(--color-muted);
		padding: 0 var(--space-md) var(--space-md);
	}

	@media (max-width: 48rem) {
		summary {
			font-size: var(--text-base);
		}
	}
</style>

<script>
	const ANIMATION_DURATION = 100;
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	document.querySelectorAll(".faq").forEach((details) => {
		const summary = details.querySelector("summary");
		const content = details.querySelector(".faq-content");
		let animation = null;

		summary.addEventListener("click", (event) => {
			if (prefersReducedMotion.matches) return;
			if (!details.open) {
				details.classList.add("is-open");
				return;
			}
			event.preventDefault();
			details.classList.remove("is-open");
			animation?.cancel();
			animation = content.animate(
				{ height: [`${content.scrollHeight}px`, "0px"] },
				{ duration: ANIMATION_DURATION, easing: "ease-out" },
			);
			animation.onfinish = () => {
				details.open = false;
			};
		});

		details.addEventListener("toggle", () => {
			if (!details.open || prefersReducedMotion.matches) return;
			animation?.cancel();
			animation = content.animate(
				{ height: ["0px", `${content.scrollHeight}px`] },
				{ duration: ANIMATION_DURATION, easing: "ease-out" },
			);
		});
	});
</script>

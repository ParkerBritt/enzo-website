---
import GithubIcon from "../assets/github.svg";
import { Icon } from 'astro-icon/components';
import { DOCS_GUIDE_URL } from "../consts";

interface Props {
	activeTab?: string;
}

const { activeTab } = Astro.props;

const repoUrl = "https://github.com/parkerbritt/enzo";

const tabs = [
	{ label: "Guide", href: DOCS_GUIDE_URL, kind: "internal", icon: "lucide:book-open" },
	{ label: "Nodes", href: "/docs/nodes", kind: "soon", icon: "lucide:workflow" },
	{ label: "DasLang", href: "/docs/daslang", kind: "soon", icon: "lucide:square-function" },
	{ label: "Python", kind: "soon", icon: "simple-icons:python" },
	{ label: "C++", href: "https://parkerbritt.github.io/enzo/annotated.html", kind: "external", icon: "simple-icons:cplusplus" },
] as const;
---

<header class="docs-header">
	<div class="docs-header-inner">
		<a class="brand" href="/">
			<img src="/icons/enzo.svg" alt="Enzo" width="28" height="28" />
			<span>Enzo</span>
		</a>

		<input type="checkbox" id="docs-nav-toggle" class="nav-toggle" />
		<label for="docs-nav-toggle" class="nav-toggle-label" aria-label="Menu">
			<Icon name="lucide:menu" aria-hidden="true" />
		</label>

		<div class="docs-nav-panel">
			<nav class="docs-tabs">
				{
					tabs.map((tab) => {
						if (tab.kind === "soon") {
							return (
								<span class="docs-tab soon">
									<Icon name={tab.icon} size={16} aria-hidden="true" />
									{tab.label}
									<span class="soon-badge">Soon</span>
								</span>
							);
						}
						if (tab.kind === "external") {
							return (
								<a class="docs-tab" href={tab.href} target="_blank" rel="noopener">
									<Icon name={tab.icon} size={16} aria-hidden="true" />
									{tab.label} <span class="ext">↗</span>
								</a>
							);
						}
						return (
							<a class:list={["docs-tab", { active: tab.label === activeTab }]} href={tab.href}>
								<Icon name={tab.icon} size={16} aria-hidden="true" />
								{tab.label}
							</a>
						);
					})
				}
			</nav>

			{
				Astro.slots.has("sidebar") && (
					<div class="docs-sidebar-slot">
						<slot name="sidebar" />
					</div>
				)
			}

			<div class="docs-header-actions">
            <!-- TODO: add search functionality -->
				<!-- <div class="docs-search"> -->
				<!-- 	<Icon name="lucide:search" class="icon" size={16} aria-hidden="true" /> -->
				<!-- 	<input type="text" placeholder="Search all docs…" disabled /> -->
				<!--              <span class="kbd">/</span> -->
				<!-- </div> -->
				<a class="source" href={repoUrl} target="_blank" rel="noopener" aria-label="Source code">
					<GithubIcon width={18} height={18} aria-hidden="true" />
					<span>Source Code</span>
				</a>
			</div>
		</div>
	</div>
</header>

<style>
	.docs-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		height: var(--docs-header-height, 4.75rem);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
	}

	/* The bar's blur lives on its own layer so it stays a sibling of the mobile nav panel, which cannot blur inside a blurred ancestor. */
	.docs-header::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: color-mix(in srgb, var(--color-bg) 70%, transparent);
		backdrop-filter: blur(12px);
	}

	.docs-header-inner {
		width: 100%;
		height: 100%;
		max-width: 90rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.docs-nav-panel {
		display: contents;
	}

	.nav-toggle {
		display: none;
	}

	.nav-toggle-label {
		display: none;
		justify-self: end;
		padding: var(--space-xs);
		color: var(--color-text);
		cursor: pointer;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
		flex-shrink: 0;
	}

	.docs-sidebar-slot {
		display: none;
	}

	.docs-tabs {
		display: flex;
		align-items: stretch;
		gap: var(--space-md);
		height: 2.75rem;
	}

	.docs-tab {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--color-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 500;
		border-bottom: 2px solid transparent;
	}

	.docs-tab:hover {
		color: var(--color-text);
	}

	.docs-tab.active {
		color: var(--color-text);
		font-weight: 600;
		border-bottom-color: var(--color-accent);
	}

	.docs-tab .ext {
		color: var(--color-muted);
		font-size: var(--text-sm);
	}

	.docs-tab.soon {
		color: color-mix(in srgb, var(--color-muted) 60%, transparent);
		cursor: default;
	}

	.soon-badge {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
		border-radius: 4px;
		padding: 0.0625rem 0.3rem;
		color: var(--color-muted);
	}

	.docs-header-actions {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		flex-shrink: 0;
	}

	.docs-search {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		width: 16rem;
		height: 2.25rem;
		padding-inline: var(--space-sm);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-text) 4%, transparent);
		color: var(--color-muted);
	}

	.docs-search .icon {
		font-size: var(--text-sm);
	}

	.docs-search input {
		all: unset;
		flex: 1;
		min-width: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: var(--color-text);
	}

	.docs-search input::placeholder {
		color: var(--color-muted);
	}

	.docs-search .kbd {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-muted);
		border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
		border-radius: 4px;
		padding: 0.0625rem 0.35rem;
	}

	.source {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.source span {
		display: none;
	}

	.source:hover {
		border-color: color-mix(in srgb, var(--color-text) 15%, transparent);
		background: color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	@media (max-width: 60rem) {
		.docs-search {
			width: 12rem;
		}
	}

	@media (max-width: 48rem) {
		.docs-header-inner {
			grid-template-columns: 1fr auto;
		}

		.nav-toggle-label {
			display: flex;
		}

		.docs-nav-panel {
			display: block;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: color-mix(in srgb, var(--color-bg) 70%, transparent);
			backdrop-filter: blur(12px);
			border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
			max-height: 0;
			overflow-y: auto;
			visibility: hidden;
			transition: max-height 0.2s ease, visibility 0.2s ease;
		}

		.nav-toggle:checked ~ .docs-nav-panel {
			max-height: calc(100vh - var(--docs-header-height, 4.75rem));
			visibility: visible;
		}

		.docs-tabs {
			flex-direction: column;
			align-items: stretch;
			height: auto;
			gap: 0;
			padding: var(--space-sm);
		}

		.docs-tab {
			padding: var(--space-sm) var(--space-xs);
			border-bottom: none;
		}

		.docs-sidebar-slot {
			display: block;
			padding: var(--space-sm) var(--space-sm) var(--space-sm);
			border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
		}

		.docs-header-actions {
			justify-content: center;
			padding: 0 var(--space-sm) var(--space-sm);
		}

		.source {
			width: auto;
			height: auto;
			padding: var(--space-xs) var(--space-sm);
		}

		.source span {
			display: inline;
		}

		.docs-search {
			width: auto;
			flex: 1;
		}
	}
</style>

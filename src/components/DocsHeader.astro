---
import GithubIcon from "../assets/github.svg";
import { Icon } from 'astro-icon/components';

interface Props {
	activeTab?: string;
}

const { activeTab } = Astro.props;

const repoUrl = "https://github.com/parkerbritt/enzo";

const tabs = [
	{ label: "Guide", href: "/docs/guide", kind: "internal", icon: "lucide:book-open" },
	{ label: "Nodes", href: "/docs/nodes", kind: "soon", icon: "lucide:workflow" },
	{ label: "DasLang", href: "/docs/daslang", kind: "soon", icon: "lucide:square-function" },
	{ label: "Python", kind: "soon", icon: "simple-icons:python" },
	{ label: "C++", href: "https://parkerbritt.github.io/enzo/annotated.html", kind: "external", icon: "simple-icons:cplusplus" },
] as const;
---

<header class="docs-header">
	<div class="docs-header-inner">
		<a class="brand" href="/">
			<img src="/icons/enzo.svg" alt="Enzo" width="28" height="28" />
			<span>Enzo</span>
		</a>

		<nav class="docs-tabs">
			{
				tabs.map((tab) => {
					if (tab.kind === "soon") {
						return (
							<span class="docs-tab soon">
								<Icon name={tab.icon} size={16} aria-hidden="true" />
								{tab.label}
								<span class="soon-badge">Soon</span>
							</span>
						);
					}
					if (tab.kind === "external") {
						return (
							<a class="docs-tab" href={tab.href} target="_blank" rel="noopener">
								<Icon name={tab.icon} size={16} aria-hidden="true" />
								{tab.label} <span class="ext">↗</span>
							</a>
						);
					}
					return (
						<a class:list={["docs-tab", { active: tab.label === activeTab }]} href={tab.href}>
							<Icon name={tab.icon} size={16} aria-hidden="true" />
							{tab.label}
						</a>
					);
				})
			}
		</nav>

		<div class="docs-header-actions">
            <!-- TODO: add search functionality -->
			<!-- <div class="docs-search"> -->
			<!-- 	<Icon name="lucide:search" class="icon" size={16} aria-hidden="true" /> -->
			<!-- 	<input type="text" placeholder="Search all docs…" disabled /> -->
			<!--              <span class="kbd">/</span> -->
			<!-- </div> -->
			<a class="source" href={repoUrl} target="_blank" rel="noopener" aria-label="Source code">
				<GithubIcon width={18} height={18} aria-hidden="true" />
			</a>
		</div>
	</div>
</header>

<style>
	.docs-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		height: var(--docs-header-height, 4.75rem);
		background: color-mix(in srgb, var(--color-bg) 70%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
	}

	.docs-header-inner {
		width: 100%;
		height: 100%;
		max-width: 90rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
		flex-shrink: 0;
	}

	.docs-tabs {
		display: flex;
		align-items: stretch;
		gap: var(--space-md);
		height: 2.75rem;
	}

	.docs-tab {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--color-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 500;
		border-bottom: 2px solid transparent;
	}

	.docs-tab:hover {
		color: var(--color-text);
	}

	.docs-tab.active {
		color: var(--color-text);
		font-weight: 600;
		border-bottom-color: var(--color-accent);
	}

	.docs-tab .ext {
		color: var(--color-muted);
		font-size: var(--text-sm);
	}

	.docs-tab.soon {
		color: color-mix(in srgb, var(--color-muted) 60%, transparent);
		cursor: default;
	}

	.soon-badge {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
		border-radius: 4px;
		padding: 0.0625rem 0.3rem;
		color: var(--color-muted);
	}

	.docs-header-actions {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		flex-shrink: 0;
	}

	.docs-search {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		width: 16rem;
		height: 2.25rem;
		padding-inline: var(--space-sm);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-text) 4%, transparent);
		color: var(--color-muted);
	}

	.docs-search .icon {
		font-size: var(--text-sm);
	}

	.docs-search input {
		all: unset;
		flex: 1;
		min-width: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: var(--color-text);
	}

	.docs-search input::placeholder {
		color: var(--color-muted);
	}

	.docs-search .kbd {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-muted);
		border: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
		border-radius: 4px;
		padding: 0.0625rem 0.35rem;
	}

	.source {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
		color: var(--color-text);
	}

	.source:hover {
		border-color: color-mix(in srgb, var(--color-text) 15%, transparent);
		background: color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	@media (max-width: 60rem) {
		.docs-search {
			width: 12rem;
		}
	}

	@media (max-width: 48rem) {
		.docs-header {
			height: auto;
			padding-block: var(--space-sm);
		}
		.docs-header-inner {
			height: auto;
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-sm);
		}
		.docs-tabs {
			order: 3;
			width: 100%;
			overflow-x: auto;
			height: auto;
			padding-bottom: var(--space-xs);
		}
		.docs-search {
			width: auto;
			flex: 1;
		}
	}
</style>

---
import { Icon } from "astro-icon/components";

interface Props {
	startPrice?: number;
}

const { startPrice = 4999 } = Astro.props;
---

<div class="oss-stat" data-start={startPrice}>
	<div class="lock-wrap">
		<span class="unlock-ring"></span>
		<Icon name="lucide:lock" class="lock lock-closed" aria-hidden="true" />
		<Icon name="lucide:lock-open" class="lock lock-open" aria-hidden="true" />
	</div>

	<span class="dollar-counter">${startPrice.toLocaleString()}</span>
	<span class="counter-label">GPL-3.0</span>
</div>

<script>
	const COUNTDOWN_DURATION_MS = 1000;

	function easeInOutSine(t: number) {
		return -(Math.cos(Math.PI * t) - 1) / 2;
	}

	function animate(el: HTMLElement) {
		if (el.dataset.animated) return;
		el.dataset.animated = "true";

		const start = Number(el.dataset.start) || 0;
		const counter = el.querySelector<HTMLElement>(".dollar-counter");
		if (!counter) return;

		// The displayed value is quantized to this step, so the countdown reads
		// as a small number of round ticks rather than every intermediate dollar.
		const step = 100;
		const startTime = performance.now();
		let lastShown = start;

		function tick(now: number) {
			const progress = Math.min((now - startTime) / COUNTDOWN_DURATION_MS, 1);
			const raw = start * (1 - easeInOutSine(progress));
			const value = progress < 1 ? Math.ceil(raw / step) * step : 0;

			if (value !== lastShown) {
				lastShown = value;
				counter!.textContent = "$" + value.toLocaleString();
				// The easing flattens out near the end, so this final nonzero tick
				// holds on screen for a moment, which is when the anticipation plays.
				if (value === step) counter!.classList.add("anticipating");
			}

			if (progress < 1) {
				requestAnimationFrame(tick);
			} else {
				counter!.textContent = "Free Forever";
				counter!.classList.remove("anticipating");
				el.classList.add("unlocked");
			}
		}

		requestAnimationFrame(tick);
	}

	const stats = document.querySelectorAll<HTMLElement>(".oss-stat");
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) animate(entry.target as HTMLElement);
			}
		},
		// The viewport's bottom edge is shrunk inward, so the card only counts as
		// visible once it has been scrolled up a bit past the fold.
		{ threshold: 0, rootMargin: "0px 0px -35% 0px" },
	);

	stats.forEach((stat) => observer.observe(stat));
</script>

<style>
	.oss-stat {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 24px;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
		box-shadow: 0 12px 24px color-mix(in srgb, black 20%, transparent);
	}

	@keyframes ringPulse {
		from {
			transform: scale(0.6);
			opacity: 0.6;
		}
		to {
			transform: scale(1.9);
			opacity: 0;
		}
	}

	@keyframes anticipate {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.18);
		}
	}

	@keyframes counterSlam {
		0% {
			transform: scale(1.18);
		}
		55% {
			transform: scale(0.88);
		}
		100% {
			transform: scale(1);
		}
	}

	.lock-wrap {
		position: relative;
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		margin-bottom: 8px;
	}

	.unlock-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid var(--color-accent);
		opacity: 0;
	}

	.oss-stat.unlocked .unlock-ring {
		animation: ringPulse 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.lock-wrap :global(.lock) {
		position: absolute;
		inset: 0;
		width: 64px;
		height: 64px;
		transition: opacity 0.3s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.lock-wrap :global(.lock-closed) {
		color: var(--color-muted);
		opacity: 1;
		transform: scale(1);
	}

	.lock-wrap :global(.lock-open) {
		color: var(--color-accent);
		opacity: 0;
		transform: scale(0.6);
	}

	.oss-stat.unlocked .lock-wrap :global(.lock-closed) {
		opacity: 0;
		transform: scale(0.6);
	}

	.oss-stat.unlocked .lock-wrap :global(.lock-open) {
		opacity: 1;
		transform: scale(1);
	}

	.dollar-counter {
		font-family: var(--font-mono);
		font-size: 40px;
		font-weight: 700;
		color: var(--color-text);
		line-height: 1;
		font-variant-numeric: tabular-nums;
		transition: color 0.6s ease, font-size 0.4s ease;
	}

	.dollar-counter.anticipating {
		animation: anticipate 0.5s ease-out forwards;
	}

	.oss-stat.unlocked .dollar-counter {
		color: var(--color-accent);
		font-size: 32px;
		animation: counterSlam 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
	}

	.counter-label {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}
</style>

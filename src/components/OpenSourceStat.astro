---
import { Icon } from "astro-icon/components";

interface Props {
	startPrice?: number;
}

const { startPrice = 4999 } = Astro.props;
---

<div class="oss-stat" data-start={startPrice}>
	<div class="lock-wrap">
		<span class="unlock-ring"></span>
		<Icon name="lucide:lock" class="lock lock-closed" aria-hidden="true" />
		<Icon name="lucide:lock-open" class="lock lock-open" aria-hidden="true" />
	</div>

	<span class="dollar-counter">${startPrice.toLocaleString()}</span>
	<span class="counter-label">Closed Source</span>
</div>

<script>
	const COUNTDOWN_DURATION_MS = 1500;
	const COUNTDOWN_STEP = 100;
	const COUNTDOWN_GROW_SCALE = 0.25;
	// How far up from the bottom of the viewport the card must be scrolled
	// before it counts as visible and the countdown fires.
	const TRIGGER_ROOT_MARGIN = "0px 0px -60% 0px";

	function easeInOutSine(t: number) {
		return -(Math.cos(Math.PI * t) - 1) / 2;
	}

	function animate(el: HTMLElement) {
		if (el.dataset.animated) return;
		el.dataset.animated = "true";

		const start = Number(el.dataset.start) || 0;
		const counter = el.querySelector<HTMLElement>(".dollar-counter");
		const label = el.querySelector<HTMLElement>(".counter-label");
		if (!counter) return;

		// The displayed value is quantized to this step, so the countdown reads
		// as a small number of round ticks rather than every intermediate dollar.
		const step = COUNTDOWN_STEP;
		const startTime = performance.now();
		let lastShown = start;

		function tick(now: number) {
			const progress = Math.min((now - startTime) / COUNTDOWN_DURATION_MS, 1);
			const raw = start * (1 - easeInOutSine(progress));
			const value = progress < 1 ? Math.ceil(raw / step) * step : 0;

			if (value !== lastShown) {
				lastShown = value;
				counter!.textContent = "$" + value.toLocaleString();
				// The easing flattens out near the end, so this final nonzero tick
				// holds on screen for a moment, which is when the anticipation plays.
				if (value === step) counter!.classList.add("anticipating");
			}

			// As the price falls, the number grows, so getting cheaper reads as
			// gaining weight rather than shrinking away.
			counter!.style.transform = `scale(${1 + progress * COUNTDOWN_GROW_SCALE})`;

			if (progress < 1) {
				requestAnimationFrame(tick);
			} else {
				counter!.style.transform = "";
				counter!.textContent = "Free Forever";
				counter!.classList.remove("anticipating");
				if (label) label.textContent = "GPL-3.0";
				el.classList.add("unlocked");
			}
		}

		requestAnimationFrame(tick);
	}

	const stats = document.querySelectorAll<HTMLElement>(".oss-stat");
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) animate(entry.target as HTMLElement);
			}
		},
		{ threshold: 0, rootMargin: TRIGGER_ROOT_MARGIN },
	);

	stats.forEach((stat) => observer.observe(stat));
</script>

<style>
	.oss-stat {
		/* Styling knobs, gathered here for easy tweaking. */
		--oss-gap: 12px;
		--oss-padding: 24px;
		--oss-radius: 12px;
		--oss-lock-size: 64px;
		--oss-font-size: 40px;
		--oss-font-size-unlocked: 32px;
		--oss-unlock-duration: 0.7s;
		--oss-lock-flip-duration: 0.5s;
		--oss-anticipate-duration: 0.5s;
		--oss-slam-duration: 0.4s;
		--oss-color-fade-duration: 0.6s;

		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--oss-gap);
		padding: var(--oss-padding);
		position: relative;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: var(--oss-radius);
		background: radial-gradient(
				circle at 50% 35%,
				color-mix(in srgb, var(--color-accent) 6%, transparent),
				transparent 65%
			),
			var(--color-panel);
		box-shadow: 0 12px 24px color-mix(in srgb, black 20%, transparent);
	}

	.oss-stat::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: linear-gradient(color-mix(in srgb, var(--color-text) 3%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--color-text) 3%, transparent) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: radial-gradient(circle at 50% 35%, black, transparent 60%);
		pointer-events: none;
	}

	.oss-stat.unlocked {
		background: radial-gradient(
				circle at 50% 35%,
				color-mix(in srgb, var(--color-accent) 6%, transparent),
				transparent 65%
			),
			var(--color-panel);
		transition: background var(--oss-color-fade-duration) ease;
	}

	@keyframes ringPulse {
		from {
			transform: scale(0.6);
			opacity: 0.6;
		}
		to {
			transform: scale(1.9);
			opacity: 0;
		}
	}

	@keyframes anticipate {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.18);
		}
	}

	@keyframes counterSlam {
		0% {
			transform: scale(1.18);
		}
		55% {
			transform: scale(0.88);
		}
		100% {
			transform: scale(1);
		}
	}

	.lock-wrap {
		position: relative;
		flex-shrink: 0;
		width: var(--oss-lock-size);
		height: var(--oss-lock-size);
		margin-bottom: 8px;
	}

	.unlock-ring {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid var(--color-accent);
		opacity: 0;
	}

	.oss-stat.unlocked .unlock-ring {
		animation: ringPulse var(--oss-unlock-duration) cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.lock-wrap :global(.lock) {
		position: absolute;
		inset: 0;
		width: var(--oss-lock-size);
		height: var(--oss-lock-size);
		transition: opacity 0.3s ease, transform var(--oss-lock-flip-duration) cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.lock-wrap :global(.lock-closed) {
		color: var(--color-muted);
		opacity: 1;
		transform: scale(1);
	}

	.lock-wrap :global(.lock-open) {
		color: var(--color-accent);
		opacity: 0;
		transform: scale(0.6);
	}

	.oss-stat.unlocked .lock-wrap :global(.lock-closed) {
		opacity: 0;
		transform: scale(0.6);
	}

	.oss-stat.unlocked .lock-wrap :global(.lock-open) {
		opacity: 1;
		transform: scale(1);
		filter: drop-shadow(0 2px 4px color-mix(in srgb, black 50%, transparent));
	}

	.dollar-counter {
		font-family: var(--font-mono);
		font-size: var(--oss-font-size);
		font-weight: 700;
		color: var(--color-text);
		line-height: 1;
		font-variant-numeric: tabular-nums;
		transition: color var(--oss-color-fade-duration) ease, font-size 0.4s ease;
	}

	.dollar-counter.anticipating {
		animation: anticipate var(--oss-anticipate-duration) ease-out forwards;
	}

	.oss-stat.unlocked .dollar-counter {
		color: var(--color-accent);
		font-size: var(--oss-font-size-unlocked);
		text-shadow: 0 2px 4px color-mix(in srgb, black 30%, transparent);
		animation: counterSlam var(--oss-slam-duration) cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
	}

	.counter-label {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}
</style>

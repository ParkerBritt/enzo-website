---
interface Props {
	houdiniMs?: number;
	enzoMs?: number;
}

const { houdiniMs = 1719, enzoMs = 45.4 } = Astro.props;

function fmt(ms: number) {
	if (ms < 1000) return (Number.isInteger(ms) ? ms : ms.toFixed(1)) + " ms";
	return (ms / 1000).toFixed(2) + " s";
}

const speedup = enzoMs > 0 ? Math.round(houdiniMs / enzoMs) : 0;

// Seconds of loop time per ms of real cook time. Ratio between rows stays exact (1719/45.4 ≈ 38x);
// raise this to slow the whole animation down, lower it to speed it up.
const speedScale = 0.08;
function duration(ms: number) {
	return ms * speedScale;
}

const methodNote =
	"This compares a Enzo vs Houdini cooking a node headlessly. Each figure is the fastest available method in that tool, Houdini cannot run headless in C++, while Enzo can. Averaged over 50 runs.";

const rows = [
	{
		name: "Houdini",
		lang: "hython",
		label: fmt(houdiniMs),
		durationS: duration(houdiniMs),
		fill: "#5c5c68",
		textColor: "var(--color-muted)",
		rowBg: "#181820",
		rowBorder: "transparent",
	},
	{
		name: "Enzo",
		lang: "C++",
		label: fmt(enzoMs),
		durationS: duration(enzoMs),
		fill: "var(--color-accent)",
		textColor: "var(--color-accent)",
		rowBg: "color-mix(in oklch, var(--color-accent) 10%, #181820)",
		rowBorder: "color-mix(in oklch, var(--color-accent) 30%, transparent)",
	},
];
---

<div class="launch-stat">
	<div class="top">
		<div class="header-copy">
			<span class="eyebrow">Benchmark</span>
			<h3 class="title">Time to first cook</h3>
		</div>
		<span class="lang-wrap" tabindex="0">
			<svg width="16" height="16" viewBox="0 0 16 16" class="info-icon">
				<circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
				<line x1="8" y1="5" x2="8" y2="8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
				></line>
				<circle cx="8" cy="11" r="0.8" fill="currentColor"></circle>
			</svg>
			<span class="tooltip">{methodNote}</span>
		</span>
	</div>

	<div class="divider"></div>

	<div class="speedup">
		<span class="speedup-value">{speedup}×</span>
		<span class="speedup-label">faster to first cook</span>
	</div>

	<div class="divider"></div>

	<div class="rows">
		{
			rows.map((row) => (
				<div class="row">
					<div class="row-name">
						<span class="name">{row.name}</span>
						<!-- <span class="lang">{row.lang}</span> -->
					</div>
					<div
						class="bar-track"
						style={`background: ${row.rowBg}; border-color: ${row.rowBorder}`}
					>
						<div
							class="bar-fill"
							style={`animation-duration: ${row.durationS}s; background: ${row.fill}`}
						/>
					</div>
					<span class="label" style={`color: ${row.textColor}`}>
						{row.label}
					</span>
				</div>
			))
		}
	</div>
</div>

<style>
	@keyframes fillLoop {
		from {
			width: 0%;
		}
		to {
			width: 100%;
		}
	}

	.launch-stat {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 18px 22px;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
	}

	.top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.header-copy {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.title {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.2;
		color: var(--color-text);
	}

	.divider {
		height: 1px;
		background: color-mix(in srgb, var(--color-text) 9%, transparent);
		margin: 12px 0;
	}

	.lang-wrap {
		position: relative;
		display: inline-flex;
		outline: none;
		flex-shrink: 0;
	}

	.info-icon {
		color: var(--color-muted);
	}

	.tooltip {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		width: 230px;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		line-height: 1.5;
		text-align: left;
		white-space: normal;
		padding: 10px 12px;
		border: 1px solid #34343f;
		border-radius: 8px;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.15s ease;
		z-index: 20;
	}

	.lang-wrap:hover .tooltip,
	.lang-wrap:focus-visible .tooltip {
		opacity: 1;
		visibility: visible;
	}

	.speedup {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
	}

	.speedup-value {
		font-family: var(--font-mono);
		font-size: 48px;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.speedup-label {
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.02em;
		color: var(--color-muted);
	}

	.rows {
		display: flex;
		flex-direction: column;
		gap: 0px;
	}

	.row {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 10px 14px;
		border-radius: 10px;
		border: 1px solid transparent;
	}

	.row-name {
		display: flex;
		flex-direction: column;
		gap: 2px;
		width: 72px;
		flex-shrink: 0;
	}

	.name {
		font-size: 14px;
		font-weight: 700;
		color: var(--color-text);
	}

	.lang {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 10px;
		color: var(--color-muted);
	}

	.label {
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 700;
		flex-shrink: 0;
		text-align: right;
		min-width: 64px;
	}

	.bar-track {
		flex: 1;
		min-width: 0;
		height: 22px;
		border: 1px solid transparent;
		border-radius: 8px;
		overflow: hidden;
	}

	.bar-fill {
		width: 100%;
		height: 100%;
		border-radius: 8px;
		animation-name: fillLoop;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}
</style>

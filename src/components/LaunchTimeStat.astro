---
interface Props {
	houdiniMs?: number;
	enzoMs?: number;
}

const { houdiniMs = 1719, enzoMs = 45.4 } = Astro.props;

function fmt(ms: number) {
	if (ms < 1000) return (Number.isInteger(ms) ? ms : ms.toFixed(1)) + " ms";
	return (ms / 1000).toFixed(2) + " s";
}

const max = Math.max(houdiniMs, enzoMs);
const speedup = enzoMs > 0 ? Math.round(houdiniMs / enzoMs) : 0;

const methodNote =
	"This compares a Enzo vs Houdini cooking a node headlessly. Each figure is the fastest available method in that tool, Houdini cannot run headless in C++, while Enzo can. Averaged over 50 runs.";

const rows = [
	{
		name: "Houdini",
		lang: "hython",
		label: fmt(houdiniMs),
		pct: Math.max(3, (houdiniMs / max) * 100),
		fill: "#6f6f7d",
		textColor: "var(--color-bold)",
	},
	{
		name: "Enzo",
		lang: "C++",
		label: fmt(enzoMs),
		pct: Math.max(3, (enzoMs / max) * 100),
		fill: "var(--color-accent)",
		textColor: "var(--color-accent)",
	},
];
---

<div class="launch-stat">
	<div class="top">
		<div class="header-copy">
			<!-- <div class="eyebrow">Cook Performance</div> -->
			<h3 class="title">Time to first cook</h3>
			<p class="subtitle">Lower is better</p>
		</div>
		<div class="speedup">
			<span class="speedup-value">{speedup}×</span>
			<span class="speedup-label">faster to cook</span>
		</div>
	</div>

	<div class="rows">
		{
			rows.map((row) => (
				<div class="row">
					<div class="row-head">
						<div class="row-name">
							<span class="name">{row.name}</span>
							<span class="lang-wrap" tabindex="0">
								<span class="lang">{row.lang}</span>
								<span class="tooltip">{methodNote}</span>
							</span>
						</div>
						<span class="label" style={`color: ${row.textColor}`}>
							{row.label}
						</span>
					</div>
					<div class="bar-track">
						<div class="bar-fill" style={`width: ${row.pct}%; background: ${row.fill}`} />
					</div>
				</div>
			))
		}
	</div>
</div>

<style>
	@keyframes barGrow {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.launch-stat {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 24px;
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-panel);
	}

	.top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.header-copy {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.title {
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.15;
		color: var(--color-text);
	}

	.subtitle {
		font-size: 12px;
		color: var(--color-muted);
		max-width: 15rem;
	}

	.speedup {
		text-align: right;
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.speedup-value {
		font-family: var(--font-mono);
		font-size: 30px;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
	}

	.speedup-label {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-top: 6px;
	}

	.rows {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.row {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.row-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.row-name {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
	}

	.name {
		font-size: 16px;
		font-weight: 600;
		color: var(--color-text);
	}

	.lang-wrap {
		position: relative;
		display: inline-flex;
		outline: none;
	}

	.lang {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 11px;
		color: var(--color-muted);
		border: 1px solid #34343f;
		border-radius: 5px;
		padding: 2px 8px;
		white-space: nowrap;
	}

	.tooltip {
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		transform: translateX(-50%);
		width: 220px;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		line-height: 1.5;
		text-align: left;
		white-space: normal;
		padding: 10px 12px;
		border: 1px solid #34343f;
		border-radius: 8px;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.15s ease;
		z-index: 20;
	}

	.lang-wrap:hover .tooltip,
	.lang-wrap:focus-visible .tooltip {
		opacity: 1;
		visibility: visible;
	}

	.label {
		font-family: var(--font-mono);
		font-size: 18px;
		font-weight: 700;
	}

	.bar-track {
		height: 22px;
		background: #26262f;
		border-radius: 6px;
		overflow: hidden;
	}

	.bar-fill {
		height: 100%;
		border-radius: 6px;
		transform-origin: left;
		animation: barGrow 3s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
</style>

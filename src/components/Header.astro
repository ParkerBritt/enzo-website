---
import GithubIcon from "../assets/github.svg";

const repoUrl = "https://github.com/parkerbritt/enzo";
---

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/">
            <img src="/icons/enzo.svg" alt="Enzo" width="28" height="28" />
            <span>Enzo</span>
        </a>
        <nav>
            <a href="https://github.com/parkerbritt/enzo/releases/latest">Download</a>
            <div class="docs-menu">
                <a href="/docs">Docs</a>
                <div class="docs-dropdown">
                    <a href="/docs/user-guide">User Guide</a>
                    <a href="/docs/nodes">Nodes</a>
                    <a href="/docs/daslang">Daslang</a>
                    <a href="/docs/cpp">C++</a>
                </div>
            </div>
            <a href="#features">Features</a>
            <a href="#roadmap">Roadmap</a>
        </nav>
        <a class="source" href={repoUrl} target="_blank" rel="noopener">
            <GithubIcon width={18} height={18} aria-hidden="true" />
            <span>Source Code</span>
        </a>
    </div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding-block: var(--space-sm);
		background: color-mix(in srgb, var(--color-bg) 70%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.header-inner {
		width: 100%;
		max-width: 85rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: var(--space-md);
	}

	nav a {
		color: var(--color-muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--color-text);
	}

	.docs-menu {
		position: relative;
	}

    /* Invisible bridge to prevent popup from dissapearing when moving the mouse down. */
	.docs-menu::after {
		content: "";
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		height: var(--space-xs);
	}

	.docs-dropdown {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		min-width: 10rem;
		padding: var(--space-xs);
		margin-top: var(--space-xs);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: var(--color-bg);
		box-shadow: 0 8px 24px color-mix(in srgb, black 20%, transparent);
		opacity: 0;
		visibility: hidden;
		transform: translateX(-50%) translateY(-4px);
		transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
	}

	.docs-menu:hover .docs-dropdown,
	.docs-menu:focus-within .docs-dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}

	.docs-dropdown a {
		padding: var(--space-xs) var(--space-sm);
		border-radius: 8px;
		white-space: nowrap;
	}

	.docs-dropdown a:hover {
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
	}

	.source {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-xs) var(--space-sm);
		border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
		border-radius: 12px;
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.source:hover {
		border-color: color-mix(in srgb, var(--color-text) 15%, transparent);
		background: color-mix(in srgb, var(--color-text) 12%, transparent);
	}
</style>
